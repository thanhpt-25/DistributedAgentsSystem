# Copy to deploy/.env (git-ignored) and replace every placeholder.
# docker compose reads this file for ${...} interpolation. The manager and
# worker services receive only the DAS__LLM__* names that are set here.
# Never put credentials in deploy/config/*.yaml: the loader rejects them there.

# --- RabbitMQ default user (also used in the agents' amqp:// URL) ------------
RABBITMQ_USER=das
RABBITMQ_PASS=change-me-rabbitmq-password

# --- Gateway API keys (comma-separated; clients send one in X-API-Key) -------
DAS_GATEWAY_API_KEYS=change-me-api-key

# --- Gateway Admin_API keys (comma-separated; /v1/admin/* endpoints) ---------
# Empty keeps the Admin_API disabled. Each key: 16-256 printable ASCII
# characters, at most 32 keys, none equal to a DAS_GATEWAY_API_KEYS entry.
DAS__ADMIN_API_KEYS=

# --- LLM provider for managers and workers ------------------------------------
# openai | anthropic | bedrock | ollama
DAS__LLM__PROVIDER=openai
DAS__LLM__MODEL=gpt-4o-mini
# Required for openai and anthropic. Leave empty for ollama.
DAS__LLM__API_KEY=
# Ollama (start the stack with --profile ollama, then pull the model once:
#   docker compose -f deploy/docker-compose.yml exec ollama ollama pull llama3.2):
# DAS__LLM__PROVIDER=ollama
# DAS__LLM__MODEL=llama3.2
# DAS__LLM__BASE_URL=http://ollama:11434
# Bedrock (omit both keys to use the default AWS credential chain):
# DAS__LLM__AWS_REGION=us-east-1
# DAS__LLM__AWS_ACCESS_KEY_ID=
# DAS__LLM__AWS_SECRET_ACCESS_KEY=

# --- Observability profile (--profile observability) --------------------------
# Grafana admin login on http://127.0.0.1:3000. Both are required: Grafana
# exits naming the missing variable instead of starting with admin/admin.
GRAFANA_ADMIN_USER=das-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# true sends traces from every agent to Jaeger (UI: http://127.0.0.1:16686).
# Enable the observability profile too; otherwise agents only log a warning.
DAS__TRACING__ENABLED=false

# --- Optional address / port overrides ----------------------------------------
# DAS_RABBITMQ_HOST=rabbitmq
# DAS_REDIS_HOST=redis
# DAS_GATEWAY_PORT=8080
# DAS_RABBITMQ_MGMT_PORT=15672
# DAS_OLLAMA_TAG=0.12.6
