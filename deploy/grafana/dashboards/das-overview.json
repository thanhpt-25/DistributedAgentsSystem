          "expr": "sum by (capability, state) (rate(das_job_transitions_total[5m]))",
          "legendFormat": "{{capability}} {{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job attempts",
      "datasource": {
        "type": "prometheus",
