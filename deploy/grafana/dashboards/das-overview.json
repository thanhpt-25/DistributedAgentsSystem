          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "das-prometheus"
          },
          "expr": "sum by (capability) (rate(das_job_attempts_sum[5m])) / sum by (capability) (rate(das_job_attempts_count[5m]))",
