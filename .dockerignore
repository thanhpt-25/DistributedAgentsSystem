# Images only need pyproject.toml, uv.lock and das/. Keep the context small and
# free of local state or secrets.
.git
.gitignore
.venv
.kiro
.hypothesis
.pytest_cache
.import_linter_cache
**/__pycache__
**/*.py[cod]
*.egg-info
dist
build
tests
deploy
# ...except what the console image copies (deploy/docker/console.Dockerfile)
!deploy/config/console.nginx.conf
console/node_modules
console/dist
CLAUDE.md
.env
.env.*
*.secrets*
