+RID = "r1"
+DLID = "ab" * 16
+CFG = MachineConfig(max_attempts=3, base_backoff=2, max_backoff=60, capability_wait=60)
+WORKERS = (
+    AgentRecord(
+        agent_id="w1",
+        role="worker",
+        host="h",
+        capabilities=frozenset({"research"}),
+        status="Available",
+        last_heartbeat=0.0,
+    ),
+)
+META = {"provider": "openai", "model": "gpt-x"}
