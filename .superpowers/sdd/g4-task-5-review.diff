+++ das/state/lua/claim_webhook.lua	2026-10-30 14:36:13
@@ -0,0 +1,31 @@
+-- claim_webhook: claim the next due Webhook_Delivery (Phase 4 Req 8.3).
+-- Scans at most 10 rids with score <= now (Redis TIME). A rid whose delivery hash is
+-- missing or not pending is removed from the outbox. The first pending one is
+-- re-scored to now + lease, so no other sender sees it as due until the lease ends,
+-- and its claim counter is incremented; complete_webhook applies only with that
+-- claim value. The hash key is built from ARGV[2] (single Redis primary, OD 4.1).
+-- KEYS[1] das:webhooks:due
+-- ARGV[1] lease seconds (> 0), ARGV[2] request key prefix 'das:req:'
+-- Returns {rid, claim, attempts, url, secret_name, event_id, type, data} or {}.
+local lease = tonumber(ARGV[1])
+if not lease or lease ~= lease or lease <= 0 or lease == math.huge then
+  return redis.error_reply('claim_webhook: lease_seconds must be a finite number > 0')
+end
+local prefix = ARGV[2]
+if not prefix or prefix == '' then
+  return redis.error_reply('claim_webhook: request key prefix required')
+end
+local now = server_time()
+local due = redis.call('ZRANGEBYSCORE', KEYS[1], '-inf', fmt_double(now), 'LIMIT', 0, 10)
+for _, rid in ipairs(due) do
+  local wk = prefix .. rid .. ':webhook'
+  local v = redis.call('HMGET', wk, 'state', 'attempts', 'url', 'secret_name', 'event_id', 'type', 'data')
+  if v[1] ~= 'pending' then
+    redis.call('ZREM', KEYS[1], rid)
+  else
+    redis.call('ZADD', KEYS[1], fmt_double(now + lease), rid)
+    local claim = redis.call('HINCRBY', wk, 'claim', 1)
+    return { rid, tostring(claim), v[2] or '0', v[3] or '', v[4] or '', v[5] or '', v[6] or '', v[7] or '{}' }
+  end
+end
+return {}
diff --color -ruN -U8 -x __pycache__ /tmp/das_sdd_snaps/snap-g4-5/das/state/lua/complete_webhook.lua das/state/lua/complete_webhook.lua
--- /tmp/das_sdd_snaps/snap-g4-5/das/state/lua/complete_webhook.lua	1970-01-01 08:00:00
+++ das/state/lua/complete_webhook.lua	2026-10-30 14:36:12
@@ -0,0 +1,36 @@
+-- complete_webhook: record the outcome of one Webhook_Delivery attempt (Phase 4 Req 8.5-8.7).
+-- Fenced by the claim counter: applied only when the hash exists, is pending and its
+-- claim equals ARGV[2]. A sender whose lease ran out and whose delivery was claimed
+-- again gets STALE and changes nothing. Inputs are validated before any write.
+--   delivered -> state delivered, ZREM outbox
+--   failed    -> state failed, ZREM outbox
+--   retry     -> stays pending, ZADD outbox next_due
+-- Every applied outcome increments attempts and stores last_status.
+-- KEYS[1] das:webhooks:due, KEYS[2] das:req:{rid}:webhook
+-- ARGV[1] rid, ARGV[2] claim, ARGV[3] outcome, ARGV[4] last_status,
+-- ARGV[5] next_due (Redis seconds, %.17g text; '' unless retry)
+-- Returns {'OK', attempts} | {'STALE'}.
+local rid, claim, outcome, last_status = ARGV[1], ARGV[2], ARGV[3], ARGV[4] or ''
+if outcome ~= 'delivered' and outcome ~= 'retry' and outcome ~= 'failed' then
+  return redis.error_reply('complete_webhook: unknown outcome ' .. tostring(outcome))
+end
+local next_due
+if outcome == 'retry' then
+  next_due = tonumber(ARGV[5] or '')
+  if not next_due or next_due ~= next_due or next_due == math.huge or next_due == -math.huge then
+    return redis.error_reply('complete_webhook: retry needs a finite numeric next_due')
+  end
+end
+local v = redis.call('HMGET', KEYS[2], 'state', 'claim')
+if v[1] ~= 'pending' or v[2] ~= claim then
+  return { 'STALE' }
+end
+local attempts = redis.call('HINCRBY', KEYS[2], 'attempts', 1)
+redis.call('HSET', KEYS[2], 'last_status', last_status)
+if outcome == 'retry' then
+  redis.call('ZADD', KEYS[1], fmt_double(next_due), rid)
+else
+  redis.call('HSET', KEYS[2], 'state', outcome)
+  redis.call('ZREM', KEYS[1], rid)
+end
+return { 'OK', attempts }
